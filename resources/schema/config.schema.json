{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/sayuprc/arch-scaffy/v1/config.schema.json",
    "title": "Config schema for ArchScaffy",
    "description": "ArchScaffy configuration file schema",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "description": "Settings applied to all generated files",
            "properties": {
                "root": {
                    "type": "string",
                    "description": "The base directory for file output, as defined in the configuration file",
                    "default": "."
                },
                "strict": {
                    "type": "boolean",
                    "description": "Strict mode enabled",
                    "default": true
                }
            },
            "required": [
                "root",
                "strict"
            ]
        },
        "class": {
            "type": "object",
            "description": "Default configuration applied to generated classes",
            "properties": {
                "final": {
                    "type": "boolean",
                    "description": "Final class enabled",
                    "default": false
                },
                "readonly": {
                    "type": "boolean",
                    "description": "readonly class enabled",
                    "default": false
                }
            },
            "required": [
                "final",
                "readonly"
            ]
        }
    },
    "required": [
        "global",
        "class"
    ]
}
