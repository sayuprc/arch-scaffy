{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/sayuprc/arch-scaffy/v1/blueprint.schema.json",
    "title": "Blueprint schema for ArchScaffy",
    "description": "ArchScaffy blueprint file schema",
    "type": "object",
    "properties": {
        "layers": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "output": {
                        "type": "string"
                    },
                    "namespace": {
                        "type": "string"
                    }
                },
                "required": [
                    "output",
                    "namespace"
                ]
            }
        },
        "features": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "components": {
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "$ref": "#/definitions/classComponent"
                                },
                                {
                                    "$ref": "#/definitions/abstractClassComponent"
                                },
                                {
                                    "$ref": "#/definitions/interfaceComponent"
                                }
                            ]
                        }
                    }
                },
                "required": [
                    "components"
                ]
            }
        }
    },
    "required": [
        "layers",
        "features"
    ],
    "definitions": {
        "baseComponent": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Component name"
                },
                "layer": {
                    "type": "string",
                    "description": "Name of the layer the component belongs to"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "class",
                        "interface"
                    ]
                },
                "placeholders": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "name",
                "layer",
                "kind"
            ]
        },
        "classBaseComponent": {
            "allOf": [
                {
                    "$ref": "#/definitions/baseComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "class"
                        }
                    }
                }
            ]
        },
        "classComponent": {
            "allOf": [
                {
                    "$ref": "#/definitions/classBaseComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "final": {
                            "type": "boolean"
                        },
                        "readonly": {
                            "type": "boolean"
                        },
                        "abstract": {
                            "const": false
                        }
                    }
                }
            ]
        },
        "abstractClassComponent": {
            "allOf": [
                {
                    "$ref": "#/definitions/classBaseComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "abstract": {
                            "const": true
                        }
                    },
                    "required": [
                        "abstract"
                    ],
                    "not": {
                        "required": [
                            "final"
                        ]
                    }
                }
            ]
        },
        "interfaceComponent": {
            "allOf": [
                {
                    "$ref": "#/definitions/baseComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "const": "interface"
                        }
                    }
                }
            ]
        }
    }
}
