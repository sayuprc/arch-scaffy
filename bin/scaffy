#!/usr/bin/env php
<?php

declare(strict_types=1);

use ArchScaffy\Command\InitCommand;
use Composer\InstalledVersions;
use DI\ContainerBuilder;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $file) {
    if (file_exists($file)) {
        require_once $file;

        break;
    }
}

$container = new ContainerBuilder()->addDefinitions(__DIR__ . '/../config/container.php')->build();

$application = new Application(
    'Arch Scaffy',
    InstalledVersions::getPrettyVersion('sayuprc/arch-scaffy') ?? 'unknown'
);

foreach ([InitCommand::class] as $signature) {
    /** @var Command $command */
    $command = $container->make($signature);

    $application->addCommand($command);
}

$application->run();
