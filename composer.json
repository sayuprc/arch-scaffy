{
    "name": "sayuprc/arch-scaffy",
    "description": "Scaffolding tool that generates boilerplate code for layered architecture projects from YAML configuration",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "brianium/paratest": "^7.15",
        "phpstan/phpstan": "^2.1",
        "symplify/easy-coding-standard": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "ArchScaffy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "sayuprc"
        }
    ],
    "bin": [
        "bin/arch-scaffy"
    ],
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=-1 --no-progress",
        "phpstan-clear-cache": "phpstan clear-result-cache",
        "ecs": "ecs check --ansi --no-progress-bar",
        "ecs-fix": "ecs check --fix --ansi --no-progress-bar",
        "phpunit": "paratest tests"
    },
    "config": {
        "sort-packages": true
    }
}
